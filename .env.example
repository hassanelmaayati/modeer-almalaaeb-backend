# Configure these in Render's Environment settings; do not commit real values.
# Supabase Connect -> Session pooler (5432). URL-encode the password and use SSL.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# Generate once and preserve between deployments: secrets.token_urlsafe(48).
JWT_SECRET=replace-with-a-long-random-secret

# Exact frontend origins, comma-separated, without paths or trailing slashes.
# For local development, use the actual Vite origin instead.
CORS_ORIGINS=https://your-frontend.vercel.app

# Use one backend instance and one Uvicorn worker for the in-memory socket hubs.
LIFECYCLE_WORKER=on

# Optional Google OAuth web client ID; must match the frontend's Google client.
GOOGLE_CLIENT_ID=
